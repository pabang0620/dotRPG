# 복사해서 .env로 쓴다 (.env는 커밋하지 않는다). 값이 없거나 틀리면 서버가 뜨지 않는다.
NODE_ENV=development
PORT=3000
# npm run db:start 로 띄운 embedded PostgreSQL 기본 주소. 배포에서는 docker-compose 값
DATABASE_URL=postgres://postgres:postgres@localhost:5433/dotrpg
# 32자 이상 난수 문자열. 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
MIN_CLIENT_VERSION=0.1.0
# 개발용 로그인(register/login). production 기본 false, 그 밖 기본 true
AUTH_DEV_ENABLED=true
REQUEST_LOG_TTL_DAYS=7
# 비우면 server/data
GAME_DATA_DIR=
# 프록시 뒤에서만 1 이상 (X-Forwarded-For 신뢰 단수)
TRUST_PROXY=0
LOG_LEVEL=info

# 속도 제한 최대 횟수 (창 길이는 코드 고정)
RATE_REGISTER_IP_MAX=5
RATE_LOGIN_IP_MAX=20
RATE_LOGIN_FAIL_MAX=5
RATE_REFRESH_ACCOUNT_MAX=10
RATE_CHAR_CREATE_MAX=10
RATE_STATE_SAVE_MAX=1
RATE_GENERAL_IP_MAX=120

# docker-compose 전용 (postgres 컨테이너 비밀번호)
POSTGRES_PASSWORD=
