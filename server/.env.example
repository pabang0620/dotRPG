# 복사해서 .env로 쓴다 (.env는 커밋하지 않는다). 값이 없거나 틀리면 서버가 뜨지 않는다.
NODE_ENV=development
PORT=3000
# npm run db:start 로 띄운 embedded PostgreSQL 기본 주소. 배포에서는 docker-compose 값
DATABASE_URL=postgres://postgres:postgres@localhost:5433/dotrpg
# 32자 이상 난수 문자열. 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
MIN_CLIENT_VERSION=0.1.0
# 개발용 로그인(register/login). production 기본 false, 그 밖 기본 true
AUTH_DEV_ENABLED=true
REQUEST_LOG_TTL_DAYS=7
# 비우면 server/data
GAME_DATA_DIR=
# 프록시 뒤에서만 1 이상 (X-Forwarded-For 신뢰 단수)
TRUST_PROXY=0
LOG_LEVEL=info

# 속도 제한 최대 횟수 (창 길이는 코드 고정)
RATE_REGISTER_IP_MAX=5
RATE_LOGIN_IP_MAX=20
RATE_LOGIN_FAIL_MAX=5
RATE_REFRESH_ACCOUNT_MAX=10
RATE_CHAR_CREATE_MAX=10
RATE_STATE_SAVE_MAX=1
RATE_GENERAL_IP_MAX=120

# 3단계(경제) 속도 제한: IP당 분당, 캐릭터당 초당/분당
RATE_ECONOMY_IP_MAX=600
RATE_KILL_PER_SEC=6
RATE_KILL_PER_MIN=90
RATE_CLAIM_PER_SEC=5
RATE_GATHER_PER_SEC=3
RATE_NODES_PER_SEC=1
RATE_SHOP_PER_SEC=5
RATE_ENHANCE_PER_SEC=2
RATE_USE_PER_SEC=3
RATE_SLOW_PER_SEC=1

# 3단계 서버 정책 상수 (게임 데이터가 아니라 방어·운영 값, 운영하며 조정)
DROP_TTL_SECONDS=300
DROP_OPEN_PER_CHARACTER=300
KILL_BURST_FIELD=4
KILL_BURST_DUNGEON=6
KILL_SUPPLY_MARGIN=1.1
POWER_PASSIVE_PER_LEVEL=0.11
POWER_SKILL_FACTOR=2
POWER_AOE_CAP=5
ANOMALY_WINDOW_MINUTES=10
ANOMALY_BLOCK_COUNT=20
GATHER_GRACE_SECONDS=3
ITEM_USE_MIN_GAP_MS=500
RUN_STALE_SECONDS=3600
DUNGEON_ROOM_CLEAR_RATIO=0.8
# 1분에 받는 채집 수 상한(맵을 가로지르는 노드 순회 방지)
GATHER_PER_MINUTE=40
# 던전 시간 점수: 서버 경과 시간에서 로딩·연출로 빼 주는 여유(초)
DUNGEON_TIME_OVERHEAD_SECONDS=30
DUNGEON_CARD_TTL_HOURS=24

# ---- 4단계: 파티 협동 ----
PARTY_LISTING_MINUTES=10
PARTY_APPLY_SECONDS=30
PARTY_IDLE_MINUTES=30
MATCH_QUEUE_SECONDS=60
MATCH_POWER_RATIO=0.3
MATCH_START_SECONDS=60
MATCH_TICKET_STALE_SECONDS=15
PARTY_GATHER_SECONDS=90
PARTY_MIN_LEVEL_SLACK=5
HOST_STALE_SECONDS=12
PARTY_REJOIN_SECONDS=60
PARTY_RESULT_WAIT_SECONDS=90
PARTY_ELAPSED_TOLERANCE_MS=5000
PARTY_KILL_SLACK_RATIO=0.2
PARTY_POWER_SLACK=1.15
PARTY_DAMAGE_MIN_RATIO=0.8
RAID_REWARD_MIN_HUMANS=2
RAID_PRACTICE_PAYS_KILLS=false
# Steam: off | mock(개발용) | web_api(STEAM_APP_ID, STEAM_WEB_API_KEY 필요). 운영에서 mock 거부
STEAM_AUTH_MODE=off
STEAM_APP_ID=
STEAM_WEB_API_KEY=
STEAM_IDENTITY=dotrpg-server
# dev: Steam ID 없이 파티 가능(개발) | steam: 모든 멤버 Steam 연결 필수. 운영에서 dev 거부
PARTY_TRANSPORT=dev

# docker-compose 전용 (postgres 컨테이너 비밀번호)
POSTGRES_PASSWORD=

# 5단계(채팅·친구): 아래는 모두 기본값이 있어 비워 둬도 된다. 값 목록은 Docs/server/phase5_api.md 11절
# CHAT_PER_MINUTE=30
# WS_MAX_CONNECTIONS=500
# RATE_SOCIAL_IP_MAX=600

# 6단계(경매·우편): 아래는 모두 기본값이 있어 비워 둬도 된다. 값 목록은 Docs/server/phase6_api.md 3절
# 운영에서는 AUCTION_MIN_LEVEL, AUCTION_MIN_ACCOUNT_AGE_DAYS 를 0으로 둘 수 없다(기동 거부)
# AUCTION_MIN_LEVEL=10
# AUCTION_MIN_ACCOUNT_AGE_DAYS=7
# AUCTION_MAX_PRICE=1000000000
# AUCTION_PAIR_DAILY_TRADES=3
# AUCTION_PAIR_DAILY_GOLD=100000000
# AUCTION_TICK_SECONDS=60
# AUCTION_TICK_ENABLED=true
# AUCTION_REF_DAILY_CAP_BPS=15000  # 시세 중앙값이 전날 값보다 하루에 오를 수 있는 한도(15000 = 1.5배)
