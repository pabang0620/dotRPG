# 복사해서 .env로 쓴다 (.env는 커밋하지 않는다). 값이 없거나 틀리면 서버가 뜨지 않는다.
NODE_ENV=development
PORT=3000
# npm run db:start 로 띄운 embedded PostgreSQL 기본 주소. 배포에서는 docker-compose 값
DATABASE_URL=postgres://postgres:postgres@localhost:5433/dotrpg
# 32자 이상 난수 문자열. 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
MIN_CLIENT_VERSION=0.1.0
# 개발용 로그인(login). production 기본 false, 그 밖 기본 true. 운영에서 true로 두려면 ALLOW_DEV_AUTH_IN_PRODUCTION=true 가 함께 있어야 한다(기동 가드 G3)
AUTH_DEV_ENABLED=true
# 개발용 가입(register)은 로그인과 별도 스위치다. production 기본 false(공개 가입 차단), 개발 기본 true.
# Steam 연동 전 외부 시험은 AUTH_DEV_ENABLED=true + ALLOW_DEV_AUTH_IN_PRODUCTION=true + AUTH_DEV_REGISTER_ENABLED=false 로 두고 계정은 관리자 CLI 'account dev-create' 로 발급한다
# AUTH_DEV_REGISTER_ENABLED=false
# ALLOW_DEV_AUTH_IN_PRODUCTION=false
REQUEST_LOG_TTL_DAYS=7
# 비우면 server/data
GAME_DATA_DIR=
# 프록시 뒤에서만 1 이상 (X-Forwarded-For 신뢰 단수). 운영(Caddy 뒤)은 1 필수: 0이면 모든 접속자가 프록시 IP 하나로 보여 속도 제한을 전원이 공유한다(기동 거부)
TRUST_PROXY=0
LOG_LEVEL=info

# 속도 제한 최대 횟수 (창 길이는 코드 고정)
RATE_REGISTER_IP_MAX=5
RATE_LOGIN_IP_MAX=20
RATE_LOGIN_FAIL_MAX=5
RATE_REFRESH_ACCOUNT_MAX=10
RATE_CHAR_CREATE_MAX=10
RATE_STATE_SAVE_MAX=1
RATE_GENERAL_IP_MAX=120

# 3단계(경제) 속도 제한: IP당 분당, 캐릭터당 초당/분당
RATE_ECONOMY_IP_MAX=600
RATE_KILL_PER_SEC=6
RATE_KILL_PER_MIN=90
RATE_CLAIM_PER_SEC=5
RATE_GATHER_PER_SEC=3
RATE_NODES_PER_SEC=1
RATE_SHOP_PER_SEC=5
RATE_ENHANCE_PER_SEC=2
RATE_USE_PER_SEC=3
RATE_SLOW_PER_SEC=1

# 3단계 서버 정책 상수 (게임 데이터가 아니라 방어·운영 값, 운영하며 조정)
DROP_TTL_SECONDS=300
DROP_OPEN_PER_CHARACTER=300
KILL_BURST_FIELD=4
KILL_BURST_DUNGEON=6
KILL_SUPPLY_MARGIN=1.1
POWER_PASSIVE_PER_LEVEL=0.11
POWER_SKILL_FACTOR=2
POWER_AOE_CAP=5
ANOMALY_WINDOW_MINUTES=10
ANOMALY_BLOCK_COUNT=20
GATHER_GRACE_SECONDS=3
ITEM_USE_MIN_GAP_MS=500
RUN_STALE_SECONDS=3600
DUNGEON_ROOM_CLEAR_RATIO=0.8
# 1분에 받는 채집 수 상한(맵을 가로지르는 노드 순회 방지)
GATHER_PER_MINUTE=40
# 던전 시간 점수: 서버 경과 시간에서 로딩·연출로 빼 주는 여유(초)
DUNGEON_TIME_OVERHEAD_SECONDS=30
DUNGEON_CARD_TTL_HOURS=24

# ---- 4단계: 파티 협동 ----
PARTY_LISTING_MINUTES=10
PARTY_APPLY_SECONDS=120
PARTY_IDLE_MINUTES=30
MATCH_QUEUE_SECONDS=60
MATCH_POWER_RATIO=0.3
MATCH_START_SECONDS=60
MATCH_TICKET_STALE_SECONDS=15
PARTY_GATHER_SECONDS=90
PARTY_MIN_LEVEL_SLACK=5
HOST_STALE_SECONDS=12
PARTY_REJOIN_SECONDS=60
PARTY_RESULT_WAIT_SECONDS=90
PARTY_ELAPSED_TOLERANCE_MS=5000
PARTY_KILL_SLACK_RATIO=0.2
PARTY_POWER_SLACK=1.15
PARTY_DAMAGE_MIN_RATIO=0.8
RAID_REWARD_MIN_HUMANS=2
RAID_PRACTICE_PAYS_KILLS=false
# Steam: off | mock(개발용) | web_api(STEAM_APP_ID, STEAM_WEB_API_KEY 필요). 운영에서 mock 거부
STEAM_AUTH_MODE=off
STEAM_APP_ID=
STEAM_WEB_API_KEY=
STEAM_IDENTITY=dotrpg-server
# (폐기) PARTY_TRANSPORT 는 8단계의 COMBAT_TRANSPORT_ORDER 로 대체됐다. 값이 있고 COMBAT_TRANSPORT_ORDER 가 없으면 dev -> relay,dev(운영은 relay) / steam -> steam,relay 로 파생한다
# PARTY_TRANSPORT=

# docker-compose 전용 (postgres 컨테이너 비밀번호)
POSTGRES_PASSWORD=

# 5단계(채팅·친구): 아래는 모두 기본값이 있어 비워 둬도 된다. 값 목록은 Docs/server/phase5_api.md 11절
# CHAT_PER_MINUTE=30
# WS_MAX_CONNECTIONS=500
# RATE_SOCIAL_IP_MAX=600

# 6단계(경매·우편): 아래는 모두 기본값이 있어 비워 둬도 된다. 값 목록은 Docs/server/phase6_api.md 3절
# 운영에서는 AUCTION_MIN_LEVEL, AUCTION_MIN_ACCOUNT_AGE_DAYS 를 0으로 둘 수 없다(기동 거부)
# AUCTION_MIN_LEVEL=10
# AUCTION_MIN_ACCOUNT_AGE_DAYS=7
# AUCTION_MAX_PRICE=1000000000
# AUCTION_PAIR_DAILY_TRADES=3
# AUCTION_PAIR_DAILY_GOLD=10000000
# AUCTION_TICK_SECONDS=60
# AUCTION_TICK_ENABLED=true
# AUCTION_REF_DAILY_CAP_BPS=15000  # 시세 중앙값이 전날 값보다 하루에 오를 수 있는 한도(15000 = 1.5배)

# ================= 7단계: 운영(배포, 관리자, 점검, 정리, 감시) =================
# 값의 뜻과 시작값은 Docs/server/phase7_ops.md 3.3. 모두 기본값이 있어 비워 둬도 된다. 비밀값은 여기에 적지 않고 서버 .env 에만 둔다.

# ---- 운영 기동 가드(NODE_ENV=production, 틀리면 기동하지 않는다) ----
# STEAM_AUTH_MODE=web_api + STEAM_APP_ID(480 거부) + STEAM_WEB_API_KEY + PARTY_TRANSPORT=steam, TRUST_PROXY>=1,
# JWT_SECRET 은 자리표시·반복 문자 거부, ADMIN_BIND=0.0.0.0 거부. Steam 연동 전 시험 기간만 ALLOW_DEV_AUTH_IN_PRODUCTION=true

# ---- 관리자 listener(같은 프로세스, 127.0.0.1:3001, 어떤 포트로도 공개하지 않는다) ----
# ADMIN_ENABLED 를 비우면: 운영은 켜짐(키 필수), 그 밖에는 ADMIN_SECRET_KEY 가 있을 때만 켜짐
# ADMIN_ENABLED=true
# ADMIN_BIND=127.0.0.1
# ADMIN_PORT=3001
# ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128
# TOTP 비밀키 암호화 키(32바이트 base64, 기본 없음). 예: openssl rand -base64 32  (오프라인 사본을 따로 보관한다: 잃으면 모든 관리자의 2FA 를 다시 등록)
ADMIN_SECRET_KEY=
# ADMIN_SESSION_IDLE_MINUTES=30
# ADMIN_SESSION_MAX_HOURS=8
# ADMIN_LOGIN_FAIL_MAX=5
# ADMIN_LOCK_MINUTES=15
# ADMIN_RATE_PER_MIN=120
# ADMIN_GRANT_MAX_GOLD=1000000
# ADMIN_GRANT_MAX_ITEM_COUNT=99
# ADMIN_GRANT_DAILY_GOLD=5000000
# ADMIN_OPERATOR_BAN_MAX_DAYS=30
# WATCHLIST_MIN_SCORE=10
# WATCHLIST_WINDOW_HOURS=24

# ---- 점검 공지·종료 ----
# MAINT_PRE_BLOCK_MINUTES=10
# MAINT_ANNOUNCE_MINUTES=30,10,5,1
# MAINT_POLL_SECONDS=5
# MAINT_BYE_DELAY_SECONDS=3
# SHUTDOWN_GRACE_SECONDS=30
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=15000

# ---- 데이터 정리(보관 기간). 원장·경매 체결·소각·dungeon_runs 는 지우지 않는다(원장은 영구 보관) ----
# KILL_LOG_RETENTION_DAYS=7
# DROP_RETENTION_DAYS=1
# ANOMALY_RETENTION_DAYS=30
# ANOMALY_SEVERE_RETENTION_DAYS=180
# REFRESH_TOKEN_PURGE_DAYS=30
# MAIL_CLAIMED_RETENTION_DAYS=180
# PARTY_RECORD_RETENTION_DAYS=30
# JOB_RUN_RETENTION_DAYS=90
# ADMIN_SESSION_PURGE_DAYS=30
# PURGE_BATCH=5000
# PURGE_BATCH_SLEEP_MS=100
# JOB_MAX_SECONDS=300
# JOBS_ENABLED=true

# ---- 감시·알림 ----
# 웹훅(Discord/Slack) URL: URL 자체가 비밀이다. 비우면 알림은 로그에만 남긴다(경고 로그)
ALERT_WEBHOOK_URL=
# discord | slack | json
# ALERT_WEBHOOK_FORMAT=discord
# ALERT_MIN_INTERVAL_MINUTES=30
# 외부 하트비트 서비스 URL(매분 GET). 이 핑이 끊기면 서비스가 알린다. 비우면 보내지 않는다
OPS_HEARTBEAT_URL=
# SERVER_NAME=dotrpg
# OPS_SNAPSHOT_SECONDS=60
# 이미지 태그(감시 지표에 표시). deploy.sh 가 API_IMAGE 로 관리한다
# IMAGE_VERSION=dev

# ---- 배포·백업(ops/ 폴더, 서버 업체·도메인이 정해지면 채운다: 모두 자리표시) ----
# 운영 compose 가 쓰는 이미지(예: dotrpg-api:<git 짧은 해시>)
API_IMAGE=
# Caddy 도메인은 ops/Caddyfile 의 api.example.com 을 바꾼다. host-check.sh 의 TLS 만료 확인용
API_DOMAIN=
# 백업 목적지: 로컬 경로(/var/backups/dotrpg) 또는 rclone:<remote>:<bucket>/dotrpg (오프사이트 S3 호환 저장소, 쓰기 전용·삭제 불가 권한 권장)
BACKUP_DEST=
# age 공개키(개인키는 서버에 두지 않는다). 없으면 BACKUP_ALLOW_PLAINTEXT=1 이 있어야 백업이 돈다(로컬 시험 전용)
BACKUP_AGE_RECIPIENT=
# BACKUP_ALLOW_PLAINTEXT=0
# 일일 백업 성공 핑(외부 서비스)
BACKUP_HEARTBEAT_URL=
# 오프사이트 저장소 자격 증명은 rclone config(호스트 ~/.config/rclone/rclone.conf)에 둔다. 이 저장소에 넣지 않는다

# ================= 8단계: 전투 중계(/relay) + 필드 파티 사냥 + Steam =================
# 값의 뜻은 Docs/server/phase8_api.md 11절. 모두 기본값이 있고, 아래 셋은 운영에서 필수다.
# 중계 티켓 서명 키(JWT_SECRET 과 다른 32자 이상 난수). RELAY_ENABLED=true 인 운영에서 없으면 기동하지 않는다. 로그에 남기지 않는다
RELAY_TICKET_SECRET=
# 클라이언트가 접속할 공개 주소(운영은 wss:// 필수, T1 응답의 relay_url). 개발 기본값 ws://localhost:<PORT>/relay
RELAY_PUBLIC_URL=
# test: 시험 서버(NODE_ENV=production 이어도 앱 ID 480, 개발 로그인 허용, 전송 기본 steam,relay) | live(기본): 480 거부, 전송 기본 relay,steam
DEPLOY_STAGE=live
# 전투 전송 우선순위(쉼표, relay | steam | dev). 비우면 DEPLOY_STAGE 기본값. 운영에서 dev 거부
# COMBAT_TRANSPORT_ORDER=relay,steam
# RELAY_ENABLED=true
# RELAY_MAX_CONNECTIONS=400
# RELAY_MAX_ROOMS=120
# RELAY_ADMISSION_RATIO=0.9
# RELAY_HOST_GRACE_MS=3000
# RELAY_EGRESS_DAILY_BUDGET_GB=
# 필드 파티 세션(처치 대조 게이트, 레벨 격차 감쇠, 경제 손잡이)
# FIELD_UNCREDITED_MAX=24
# FIELD_CARRY_SLACK=5
# FIELD_CARRY_STEP=0.15
# FIELD_CARRY_MIN=0.02
# 9단계: 몬스터 레벨 - 멤버 레벨이 이 값 이상이면 경험치는 정확히 1, 재료·장비 드롭 배율은 FIELD_CARRY_HARD_DROP_MUL. 처치 골드도 같은 배율로 줄인다
# FIELD_CARRY_HARD_GAP=15
# FIELD_CARRY_HARD_DROP_MUL=0
# FIELD_CARRY_GOLD_SCALE=true
# FIELD_PARTY_XP_FACTOR=1.0
# FIELD_PARTY_DROP_FACTOR=1.0
# Steam Web API(퍼블리셔 키를 쓰면 https://partner.steam-api.com)
# STEAM_WEB_API_BASE=https://api.steampowered.com
# STEAM_WEB_API_RETRIES=1
# STEAM_BREAKER_FAILURES=5
# STEAM_BREAKER_OPEN_SECONDS=30
# 참고: DEPLOY_STAGE=test 에서 STEAM_APP_ID=480(Valve 시험용 앱) 허용은 의도된 것이다(시험 서버 전용). live 에서는 거부한다

# ================= 9단계: 부정 행위 방지 (Docs/server/phase9_anti_abuse.md) =================
# 시험 스크립트(scripts/test-*.ts|mjs)는 DEPLOY_STAGE=test 가 명시된 환경(이 .env 포함)에서만 실행된다. 로컬 개발자는 한 번 적는다.
# 운영(NODE_ENV=production)은 DEPLOY_STAGE(test 또는 live)를 반드시 명시해야 한다(없으면 기동 실패).
# 기기 지문 해시를 저장 전에 HMAC하는 비밀(32자 이상, JWT_SECRET과 달라야 한다). 운영 필수, 개발·시험은 JWT_SECRET에서 파생한다
DEVICE_HASH_PEPPER=
# 로그인 본문에 device 필수(클라이언트가 나간 뒤 true). 같은 계정 재로그인 시 이전 세션 종료(on|off)
# DEVICE_INFO_REQUIRED=false
# SESSION_SINGLE_MODE=on
# 새 규칙은 모두 모드(off|log|enforce)가 있다. 서버를 먼저 log 로 켜고 클라이언트가 맞춰진 뒤 enforce 로 올린다
# REFRESH_DEVICE_BIND=log
# DEVICE_LIMIT_MODE=log
# DEVICE_MAX_CONCURRENT=2
# PRESENCE_KILL_MODE=log
# CONTRIBUTION_MODE=enforce
# CAREER_SERVER_TRUTH=enforce
# NAME_RESERVED_MODE=enforce
# 개인정보 보관: login_events 90일, 기기·IP 집계 마지막 관측 후 180일
# LOGIN_EVENT_RETENTION_DAYS=90
# ACCOUNT_DEVICE_RETENTION_DAYS=180
# 경제 속도 정지: off | log_only(기본, 2주 분포 확인) | enforce. 상한 표는 server/data/income_caps.json(python3 Tools/balance/theory_income.py)
# ECONOMY_HOLD_MODE=log_only
# INCOME_MAX_KILLS_PER_MIN=30
# ECONOMY_HOLD_MULT=3
# 경매: 구매자 자격(등록 자격과 같다. 운영에서 0 거부), 상점 품목 상한 배수, 같은 기기 쌍 구매 차단(기본은 기록만)
# AUCTION_BUYER_MIN_LEVEL=10
# AUCTION_BUYER_MIN_ACCOUNT_AGE_DAYS=7
# AUCTION_SHOP_CEIL_MULT=3
# AUCTION_BLOCK_SAME_DEVICE=false
# 10단계: 던전 클리어권 소탕, 운영 우편 캠페인(Docs/server/phase10_sweep_mail.md 11절). 서버를 먼저 배포하고 클라이언트가 나간 뒤 켠다
# SWEEP_ENABLED=false
# 새 우편(제목·본문·첨부 여러 개) 클라이언트가 퍼진 뒤 true. 운영에서 true 이면 아래 두 한도가 필수(없으면 기동 실패)
# CAMPAIGN_DELIVERY_ENABLED=false
# 운영에서 우편 배달을 켜면 두 상한이 필수다. 기본 권장: 우편 1통 20만, 캠페인 1개 총 1억 골드
CAMPAIGN_MAX_GOLD_PER_MAIL=200000
CAMPAIGN_MAX_GOLD_TOTAL=100000000
# CAMPAIGN_CACHE_SECONDS=30
# CAMPAIGN_MAX_CAP_COUNT=200000
# CAMPAIGN_MAX_WINDOW_DAYS=60
# CAMPAIGN_MAX_TICKETS_PER_MAIL=10
# CAMPAIGN_MAX_TARGET_IDS=2000
# CAMPAIGN_REVOKE_BATCH=2000
# RATE_SWEEP_STATUS_PER_SEC=2
# RATE_SWEEP_RUN_PER_SEC=2
# RATE_SWEEP_ALL_PER_SEC=1
# RATE_SWEEP_BUY_PER_SEC=1
# RATE_SWEEP_CLAIM_PER_SEC=1
