<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Renders the code-generated placeholder art without Unity, for quick visual review.
    After "dotnet build", run bin/Debug/net8.0/ArtPreview.dll with:
      ../../Docs/images/sprites.png              sprite sheet
      ../../Docs/images/map.png map 1            whole map at 1x
      out.png map 3 27 17 27 15                  crop: scale centerX centerY width height (tiles)
    UnityShim.cs stands in for the two Unity types the art code uses.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;MapPreview.cs;UnityShim.cs" />
    <Compile Include="../../Assets/Scripts/Runtime/Art/PixelCanvas.cs" />
    <Compile Include="../../Assets/Scripts/Runtime/Art/ProceduralArt.cs" />
    <Compile Include="../../Assets/Scripts/Runtime/Art/CharacterLook.cs" />
  </ItemGroup>
</Project>
