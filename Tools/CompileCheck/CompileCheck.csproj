<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Offline compile check for machines without Unity (e.g. CI without a licence).
    Compiles the game scripts against Unity 2021.3 reference assemblies from NuGet plus small
    API stubs for the uGUI and Input System packages (Stubs/). It catches syntax/type errors;
    it does NOT replace opening the project in Unity 6 (APIs guarded by UNITY_6000_0_OR_NEWER
    and the real package APIs are only verified by Unity itself).

      ./fetch-refs.sh
      dotnet build -p:Variant=Editor        # UNITY_EDITOR + Input System + editor scripts
      dotnet build -p:Variant=PlayerLegacy  # player build with the legacy Input Manager
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0649;CS0414;CS0618</NoWarn>
    <Variant Condition="'$(Variant)' == ''">Editor</Variant>
    <AssemblyName>DotRPG.CompileCheck.$(Variant)</AssemblyName>
    <BaseIntermediateOutputPath>obj/$(Variant)/</BaseIntermediateOutputPath>
    <OutputPath>bin/$(Variant)/</OutputPath>
    <UnityRefs>$(MSBuildThisFileDirectory)refs/unityengine.modules/lib/net45</UnityRefs>
    <UnitySdk>$(MSBuildThisFileDirectory)refs/unity3d.sdk/lib</UnitySdk>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Variant)' == 'Editor'">
    <DefineConstants>UNITY_EDITOR;UNITY_STANDALONE;ENABLE_INPUT_SYSTEM</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Variant)' == 'PlayerLegacy'">
    <DefineConstants>UNITY_STANDALONE;ENABLE_LEGACY_INPUT_MANAGER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Runtime/**/*.cs" />
    <Compile Include="../../Assets/Scripts/Editor/**/*.cs" Condition="'$(Variant)' == 'Editor'" />
    <Compile Include="Stubs/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(UnityRefs)/UnityEngine.CoreModule.dll" />
    <Reference Include="$(UnityRefs)/UnityEngine.Physics2DModule.dll" />
    <Reference Include="$(UnityRefs)/UnityEngine.TilemapModule.dll" />
    <Reference Include="$(UnityRefs)/UnityEngine.GridModule.dll" />
    <Reference Include="$(UnityRefs)/UnityEngine.AudioModule.dll" />
    <Reference Include="$(UnityRefs)/UnityEngine.UIModule.dll" />
    <Reference Include="$(UnityRefs)/UnityEngine.TextRenderingModule.dll" />
    <Reference Include="$(UnityRefs)/UnityEngine.JSONSerializeModule.dll" />
    <Reference Include="$(UnityRefs)/UnityEngine.InputLegacyModule.dll" />
    <Reference Include="$(UnityRefs)/UnityEngine.IMGUIModule.dll" />
    <Reference Include="$(UnityRefs)/UnityEngine.ImageConversionModule.dll" />
    <Reference Include="$(UnityRefs)/UnityEngine.SharedInternalsModule.dll" />
    <Reference Include="$(UnitySdk)/UnityEditor.dll" Condition="'$(Variant)' == 'Editor'" />
    <!-- UnityEditor.dll refers to the UnityEngine facade assembly (type forwards to the modules). -->
    <Reference Include="$(UnityRefs)/UnityEngine.dll" Condition="'$(Variant)' == 'Editor'" />
  </ItemGroup>
</Project>
